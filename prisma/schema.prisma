generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String?
  password         String
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  addonPurchases      AddonPurchase[]
  billingTransactions BillingTransaction[]
  creditAccount       CreditAccount?
  paymentMethods      PaymentMethod[]
  subscriptions       Subscription[]
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices SubscriptionPrice[]
}

model SubscriptionPrice {
  id                 String       @id @default(uuid())
  subscriptionPlanId String
  billingCycle       BillingCycle
  price              Decimal
  currency           String       @default("VND")
  stripePriceId      String?      @unique
  monthlyCredits     Int
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  subscriptions Subscription[]

  @@index([subscriptionPlanId])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  subscriptionPriceId  String
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(ACTIVE)

  startedAt          DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  retryCount        Int       @default(0)
  firstFailedAt     DateTime?
  canceledAt        DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  endedAt           DateTime?

  nextCreditRefillAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  subscriptionPrice   SubscriptionPrice    @relation(fields: [subscriptionPriceId], references: [id])
  billingTransactions BillingTransaction[]
  creditAccount       CreditAccount?

  @@index([userId])
  @@index([status])
}

model PaymentMethod {
  id                    String   @id @default(uuid())
  userId                String
  stripePaymentMethodId String   @unique
  type                  String
  brand                 String?
  last4                 String?
  expMonth              Int?
  expYear               Int?
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditAccount {
  id                          String    @id @default(uuid())
  userId                      String    @unique
  subscriptionId              String?   @unique
  addonBalance                Int       @default(0)
  subscriptionBalance         Int       @default(0)
  subscriptionCreditExpiresAt DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  transactions CreditTransaction[]

  @@index([subscriptionCreditExpiresAt])
}

model CreditTransaction {
  id              String                @id @default(uuid())
  creditAccountId String
  amount          Int
  type            CreditTransactionType
  description     String?
  balanceBefore   Int
  balanceAfter    Int
  referenceId     String?
  idempotencyKey  String?               @unique
  addonPurchaseId String?
  createdAt       DateTime              @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  addonPurchase AddonPurchase? @relation(fields: [addonPurchaseId], references: [id])

  @@index([creditAccountId])
  @@index([type])
  @@index([createdAt])
}

model BillingTransaction {
  id                    String                 @id @default(uuid())
  userId                String
  subscriptionId        String?
  addonPurchaseId       String?
  type                  BillingTransactionType
  status                PaymentStatus          @default(PENDING)
  amount                Decimal                @db.Decimal(10, 2)
  currency              String                 @default("usd")
  stripePaymentIntentId String?                @unique
  stripeInvoiceId       String?                @unique
  stripeChargeId        String?
  failureReason         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  addonPurchase AddonPurchase? @relation(fields: [addonPurchaseId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model CreditAddon {
  id            String   @id @default(uuid())
  name          String   @unique
  credits       Int
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("usd")
  stripePriceId String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases AddonPurchase[]
}

model AddonPurchase {
  id                    String        @id @default(uuid())
  userId                String
  creditAddonId         String
  credits               Int
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  addon CreditAddon @relation(fields: [creditAddonId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  billingTransactions BillingTransaction[]
  creditTransactions  CreditTransaction[]

  @@index([userId])
  @@index([creditAddonId])
  @@index([status])
}

model StripeWebhookEvent {
  id            String             @id @default(uuid())
  stripeEventId String             @unique
  eventType     String
  status        WebhookEventStatus @default(PENDING)
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime           @default(now())

  @@index([eventType])
  @@index([status])
}

enum BillingCycle {
  MONTHLY
  ANNUALLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  INCOMPLETE
  UNPAID
  PAUSED
  PAST_DUE
  CANCELED
  EXPIRED
}

enum CreditTransactionType {
  SUBSCRIPTION_ALLOCATION
  RESET
  ADDON_PURCHASE
  CONSUMPTION
  ADJUSTMENT
  REFUND
}

enum BillingTransactionType {
  SUBSCRIPTION_PAYMENT
  ADDON_PAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}
